# Copy to .env. Keep credentials out of version control.
NODE_ENV=development

# Local PostgreSQL 17 connection. Migrations run at API startup.
DATABASE_URL=

# PostgreSQL pool size. Default: 5.
PG_POOL_MAX=5

# Exact public application origin. Production requires HTTPS.
# Use http://localhost:5173 for the Vite development server.
AUTH_ORIGIN=http://localhost:3000
AUTH_GITHUB_ENABLED=false
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
# Configure this callback in GitHub: <AUTH_ORIGIN>/api/v1/auth/github/callback

# SMTP uses implicit TLS with certificate verification. Default port: 465.
# Production requires SMTP. Development without SMTP logs metadata, never token links.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Administrator provisioning reads these values. It never writes credentials.
MASTER_EMAIL=
MASTER_PASSWORD=
